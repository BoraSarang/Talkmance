# 톡맨스 서버 환경 변수 템플릿 (T-24에서 config 로딩 구현)
# 복사: cp .env.example .env

# 서버 포트
PORT=8080

# Neon PostgreSQL (마이그레이션/데이터)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# OpenRouter 공용 키 (서버 키 모드)
OPENROUTER_API_KEY=sk-or-v1-xxxx

# OpenCode Zen 키 (deepseek-v4-flash-free 등 무료 모델)
OPENCODE_API_KEY=opencode-xxxx

# Google Gemini API 키 (gemini-2.5-flash — 무료, https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza-xxxx

# BYOK 키 암호화 (AES-GCM, 32바이트 base64)
ENC_KEY=

# 익명 기기 JWT 서명
JWT_SECRET=

# 로그 레벨: debug|info|warn|error
LOG_LEVEL=debug

# CORS 허용 (콤마 구분)
CORS_ORIGINS=*
# NVIDIA NIM API 키 (build.nvidia.com/settings) — 옵션, 설정 시 폴백 1순위
NVIDIA_API_KEY=nvapi-여기에-발급한-키
